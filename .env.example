# ==============================================================================
# LogPulse Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# NEVER commit actual .env files, production secrets, or private keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# AWS & LocalStack Configuration
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack Endpoint (Port 4566)
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_ENDPOINT_URL=http://localhost:4566

# SQS Queue URLs (Host port 4566)
SQS_QUEUE_URL=http://localhost:4566/000000000000/logpulse-events
SQS_DLQ_URL=http://localhost:4566/000000000000/logpulse-events-dlq

# S3 Raw Archive Bucket
S3_ARCHIVE_BUCKET=logpulse-raw

# SNS Alert Topic ARN
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:logpulse-alerts

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8 - Host Port 3307 -> Container 3306)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=logpulse
DB_USER=logpulse_user
DB_PASSWORD=logpulse_password
DB_ROOT_PASSWORD=logpulse_root_password
DB_CONNECTION_LIMIT=10

# ------------------------------------------------------------------------------
# Redis Configuration (Host Port 6380 -> Container 6379)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380
REDIS_PASSWORD=
REDIS_TLS=false

# ------------------------------------------------------------------------------
# Ingest API Configuration
# ------------------------------------------------------------------------------
INGEST_PORT=3000
INGEST_API_KEY=local-dev-ingest-api-key
INGEST_MAX_BATCH_SIZE=500
INGEST_MAX_PAYLOAD_KB=1024

# ------------------------------------------------------------------------------
# Alert Engine Configuration
# ------------------------------------------------------------------------------
ALERT_API_PORT=3001
ALERT_CHECK_INTERVAL_SECONDS=60
ALERT_NOTIFICATION_EMAIL=alerts@example.com

# ------------------------------------------------------------------------------
# Python Agent Configuration
# ------------------------------------------------------------------------------
AGENT_INGEST_URL=http://localhost:3000/api/v1/logs
AGENT_BATCH_SIZE=100
AGENT_FLUSH_INTERVAL_SECONDS=5
AGENT_LOG_PATH=/var/log/syslog
AGENT_API_KEY=local-dev-ingest-api-key
