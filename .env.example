# LogPulse Environment Configuration Example
# Copy this file to .env and populate with appropriate values. DO NOT commit actual secrets.

# AWS Region & Credentials (if running locally; use IAM roles in production)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS SQS Configuration
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/logpulse-ingest-queue
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/logpulse-ingest-dlq

# AWS S3 Archive Bucket
S3_ARCHIVE_BUCKET=logpulse-raw-archive-bucket

# AWS SNS Topic for Alerts
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:logpulse-alerts-topic

# Database Configuration (RDS MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=logpulse
DB_USER=logpulse_app
DB_PASSWORD=your_secure_db_password
DB_CONNECTION_LIMIT=10

# Redis Configuration (Deduplication & rolling counters)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Ingest API Configuration
INGEST_PORT=3000
INGEST_API_KEY=your_ingest_api_token
INGEST_MAX_BATCH_SIZE=500
INGEST_MAX_PAYLOAD_KB=1024

# Alert Engine Configuration
ALERT_API_PORT=3001
ALERT_CHECK_INTERVAL_SECONDS=60
ALERT_NOTIFICATION_EMAIL=alerts@example.com

# Agent Configuration
AGENT_INGEST_URL=http://localhost:3000/api/v1/logs
AGENT_BATCH_SIZE=100
AGENT_FLUSH_INTERVAL_SECONDS=5
AGENT_LOG_PATH=/var/log/syslog
AGENT_API_KEY=your_ingest_api_token
